[
  {
    "key": "alt+p",
    "command": "jump-and-select.jumpForward",
    "description": "cursor moves to end of current line",
    "args": {
      "text": "$",
      "restrictSearch": "document",
      "putCursorOnForwardJump": "beforeCharacter"
    }
  },
  {
    "key": "alt+o",
    "command": "jump-and-select.jumpBackward",
    "description": "cursor moves to end of previous line",
    "args": {
      "text": "$",
      "restrictSearch": "document",
      "putCursorOnBackwardJump": "beforeCharacter"
    }
  },
  {
    "key": "alt+i",
    "command": "jump-and-select.jumpBackward",
    "description": "cursor moves to start of current line",
    "args": {
      "text": "^",
      "restrictSearch": "document",
      "putCursorOnBackwardJump": "beforeCharacter"
    }
  },
  {
    "key": "alt+u",
    "command": "jump-and-select.jumpForward",
    "description": "cursor moves to start of next line",
    "args": {
      "text": "^",
      "restrictSearch": "document",
      "putCursorOnForwardJump": "beforeCharacter"
    }
  },
  {
    "key": "alt+y",
    "command": "jump-and-select.jumpBackward",
    "description": "cursor moves to prevous empty line",
    "args": {
      "text": "^$",
      "restrictSearch": "document",
      "putCursorOnBackwardJump": "beforeCharacter"
    }
  },
  {
    "key": "alt+r",
    "command": "jump-and-select.jumpForward",
    "description": "cursor moves to next match, no selection",
    "args": {
      "text": "^${selectedText}(?:(?=\\w))",
      "isRegex": true
    }
  },
  {
    "key": "shift+alt+f",
    "command": "jump-and-select.jumpForwardSelect",
    "description": "cursor moves to next match and selects the match",
    "description2": "test with whitespace selected at beginning of line",
    "args": {
      "text": "^${selectedText}(?:(?=\\w))",
      "isRegex": true,
      "select": "match"
    }
  },
  {
    "key": "shift+alt+g",
    "command": "jump-and-select.jumpForwardSelect",
    "description": "cursor moves to next match and extends the current selection to include the match the match",
    "description2": "test with whitespace selected at beginning of line",
    "args": {
      "text": "^${selectedText}(?:(?=\\w))",
      "isRegex": true,
      "select": "extends"
    }
  },
  {
    "key": "shift+alt+b",
    "command": "jump-and-select.jumpBackwardSelect",
    "description": "cursor moves to previous match and extends the current selection to include the match",
    "description2": "test with whitespace selected at beginning of line",
    "args": {
      "text": "^${selectedText}(?:(?=\\w))",
      "isRegex": true
      //   "select": "match"
    }
  },
  {
    "key": "alt+k",
    "command": "jump-and-select.jumpForward",
    "description": "cursor moves to next empty line",
    "args": {
      "text": "^$",
      "isRegex": true
    }
  },
  {
    "key": "alt+j",
    "command": "jump-and-select.jumpForward",
    "description": "cursor moves to next line that contains only whitespace or nothing",
    "args": {
      "text": "^\\s*?$",
      "isRegex": true
    }
  },
  {
    "key": "alt+l",
    "command": "jump-and-select.jumpBackward",
    "description": "cursor moves to previous line that contains only whitespace or nothing",
    "args": {
      "text": "^\\s*?$",
      "isRegex": true
    }
  },
  {
    "key": "alt+k",
    "command": "jump-and-select.jumpForward",
    "description": "cursor moves to next line that is empty or has whitespace",
    "description2": "and puts cursor after any whitespace that may occur on that line",
    "args": {
      "text": "^\\s*?$",
      "isRegex": true,
      "putCursorOnForwardJump": "afterCharacter"
    }
  }
]